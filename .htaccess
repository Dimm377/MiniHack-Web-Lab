Options -Indexes -MultiViews
AcceptPathInfo Off

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)\." - [R=404,L]
    # Only these entry points and assets are public. Keep aligned with router.php.
    RewriteRule "^(?!(?:$|(?:index|login|register|logout|profile|notes|search|challenges|challenge)\.php$|api/users\.php$|assets/css/style\.css$|assets/js/app\.js$))." - [R=404,L]
</IfModule>
